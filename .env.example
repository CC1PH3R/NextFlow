# Postgres
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nextflow_db"

# Session cookie secret (generate with: `openssl rand -base64 32`)
AUTH_SECRET=

# GitHub OAuth App — identity only (https://github.com/settings/developers)
# Application name: NextFlow (local)
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
