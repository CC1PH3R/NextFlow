# Postgres
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nextflow_db"

# Session cookie secret (generate with: `openssl rand -base64 32`)
AUTH_SECRET=

# GitHub OAuth App — identity only (https://github.com/settings/developers)
# Application name: NextFlow (local)
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub App — repo access (https://github.com/settings/apps/new)
# This is a different object from the OAuth App above.
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/github/setup
# Setup URL: http://localhost:3000/api/github/setup  (enable Redirect on update)
# Webhook URL (production): https://<deployment>/api/github/webhook
# Webhook secret: (generate with: `openssl rand -base64 32`)
GITHUB_WEBHOOK_SECRET=
# Repository permissions. Organization and account permissions: none.
#   Actions: Read and write
#   Checks: Read-only
#   Contents: Read and write
#   Dependabot alerts: Read-only
#   Metadata: Read-only
#   Pull requests: Read and write
#   Workflows: Read and write
# Install: Only on this account
# After saving, accept the new permissions on the existing installation.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# One line with \n. Unquoted multiline PEMs are truncated and setup returns 500.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# AES-256-GCM for host tokens at rest. (generate with: `openssl rand -base64 32`)
TOKEN_ENCRYPTION_KEY=

# Vercel Integration — host access (https://vercel.com/dashboard/integrations/console)
# This is not Sign in with Vercel, and not the GitHub OAuth App.
# Redirect URL: http://localhost:3000/api/vercel/callback
# Also add https://<this-deployment>/api/vercel/callback once NextFlow is deployed.
# API scopes: Project (read), Deployment (read)
# Webhook: leave empty
# Install from the dashboard after saving. Do not list on the Marketplace.
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
